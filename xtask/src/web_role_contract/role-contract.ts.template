  payload: unknown,
  context = "role capabilities",
): RoleAdminCapabilities {
  const data = expectRecord(payload, context);
  return {
    actor: parseRoleActor(data["actor"], `${context}.actor`),
    actions: parseArray(data["actions"], `${context}.actions`, (value) =>
      parseRoleAdminAction(value, `${context}.action`),
    ),
  };
}

export function parseRoleCapabilitySnapshotPayload(
  payload: unknown,
