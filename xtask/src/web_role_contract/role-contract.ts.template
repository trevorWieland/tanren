  const data = expectRecord(payload, "role capability snapshot");
  return {
    capabilities: parseRoleAdminCapabilities(
      data["capabilities"],
      "role capability snapshot.capabilities",
    ),
    csrf_token: parseString(
      data["csrf_token"],
      "role capability snapshot.csrf_token",
    ),
  };
}

export function parseRoleCapabilitySnapshot(
  payload: unknown,
): RoleCapabilitySnapshotPayload {
  const snapshot = parseRoleCapabilitySnapshotPayload(payload);
  return {
    capabilities: {
      ...snapshot.capabilities,
      actor: {
        account_id: asAccountId(
          parseNonEmptyString(
            snapshot.capabilities.actor.account_id,
            "role capability snapshot.capabilities.actor.account_id",
          ),
        ),
      },
    },
    csrf_token: parseNonEmptyString(
      snapshot.csrf_token,
      "role capability snapshot.csrf_token",
    ),
  };
}

function parseRoleScope(value: unknown, context: string): RoleScope {
  const data = expectRecord(value, context);
  const scope = parseRoleScopeKindStrict(
    parseString(data["scope"], `${context}.scope`),
    `${context}.scope`,
  );
  switch (scope) {
    case "organization":
      return {
        scope,
        org_id: parseOrgIdValue(data["org_id"], `${context}.org_id`),
      };
    case "project":
      return {
        scope,
        project_id: parseProjectIdValue(
          data["project_id"],
          `${context}.project_id`,
        ),
      };
    case "account":
      return {
        scope,
        account_id: parseAccountIdValue(
          data["account_id"],
          `${context}.account_id`,
        ),
      };
    default:
      return assertNever(scope, `${context}.scope`);
  }
}

function parsePermissionScope(
  value: unknown,
  context: string,
): PermissionScope {
  const scope = parseRoleScope(value, context);
  switch (scope.scope) {
    case "organization":
      return { scope: "organization", org_id: scope.org_id };
    case "project":
      return { scope: "project", project_id: scope.project_id };
    case "account":
      return { scope: "account", account_id: scope.account_id };
    default:
      return assertNever(scope, context);
  }
}

function parsePrincipalRef(value: unknown, context: string): PrincipalRef {
  const data = expectRecord(value, context);
  const principal = parsePrincipalKindStrict(
    parseString(data["principal"], `${context}.principal`),
    `${context}.principal`,
  );
  switch (principal) {
    case "role":
      return parseRolePrincipalRejectionRef(data, context);
    case "account":
      return parseAccountPrincipalRef(data, context);
    default:
      return assertNever(principal, `${context}.principal`);
  }
}

function parseAccountPrincipalRef(
  value: unknown,
  context: string,
): AccountPrincipalRef {
  const data = expectRecord(value, context);
  return {
    principal: "account",
    account_id: parseAccountIdValue(
      data["account_id"],
      `${context}.account_id`,
    ),
  };
}

function parseRolePrincipalRejectionRef(
  value: unknown,
  context: string,
): RolePrincipalRejectionRef {
  const data = expectRecord(value, context);
  return {
    principal: "role",
    role_id: parseRoleIdValue(data["role_id"], `${context}.role_id`),
  };
}

