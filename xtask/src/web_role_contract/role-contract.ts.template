export type RoleTransportFailureCode = "transport_error";

export type RoleFailureCode = RoleServerFailureCode | RoleTransportFailureCode;

export interface RoleFailureBody {
  code: RoleFailureCode;
  summary: string;
}

export interface RoleCapabilitySnapshotPayload {
  capabilities: RoleAdminCapabilities;
  csrf_token: string;
}

__ROLE_FAILURE_SUMMARIES_OBJECT__

const ROLE_ADMIN_ACTIONS: readonly RoleAdminAction[] = [
  "create_role",
  "edit_role",
  "delete_role",
  "apply_role",
  "read_roles",
  "check_permission",
];

export function asRoleId(value: string): RoleId {
  return value as RoleId;
}

export function asAccountId(value: string): AccountId {
  return value as AccountId;
}

export function asOrgId(value: string): OrgId {
  return value as OrgId;
}

export function asProjectId(value: string): ProjectId {
  return value as ProjectId;
}

export function asPermissionName(value: string): PermissionName {
  return value as PermissionName;
}

export function asPermissionGrantId(value: string): PermissionGrantId {
  return value as PermissionGrantId;
}

export function asRoleTemplateCursorId(value: string): RoleTemplateCursorId {
  return value as RoleTemplateCursorId;
}

export function asPermissionGrantCursorId(
  value: string,
): PermissionGrantCursorId {
  return value as PermissionGrantCursorId;
}

export function parseRoleScopeKind(raw: string): RoleScope["scope"] {
  return parseRoleScopeKindStrict(raw, "role scope kind");
}

export function parsePrincipalKind(raw: string): PrincipalRef["principal"] {
  return parsePrincipalKindStrict(raw, "principal kind");
}

export function roleFailureSummaryForCode(code: RoleServerFailureCode): string {
  return ROLE_FAILURE_SUMMARIES[code];
}

__ROLE_FAILURE_SUMMARY_ANY_FUNCTION__

export function isRoleServerFailureCode(
  code: string,
): code is RoleServerFailureCode {
  return Object.prototype.hasOwnProperty.call(ROLE_FAILURE_SUMMARIES, code);
}

export function parseRoleFailure(payload: unknown): RoleFailureBody {
  if (isRecord(payload)) {
    const code = parseRoleFailureCode(payload["code"]);
    const summary = payload["summary"];
    if (code !== null) {
      return {
        code,
        summary:
          typeof summary === "string"
            ? summary.trim() || roleFailureSummaryForAnyCode(code)
            : roleFailureSummaryForAnyCode(code),
      };
    }
  }
  return {
    code: "transport_error",
    summary: roleFailureSummaryForAnyCode("transport_error"),
  };
}

